# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 本机联调用的工具与隔离家目录（不入库）
tools/
.toolhome/

# 引擎默认输出目录（可用 --run-root/--templates-dir 改到别处）
.tu-runs/
# 旧的本地模板目录：模板现在随仓库交付在 templates/ 下（见 README「仓库结构」）
.tu-templates/

# PyInstaller（Plan 2）
build/
dist/
*.spec
# 但 packaging/ 下的 spec 是交付物本身，必须入库：
# 上面那条 `*.spec` 原本是挡 pyinstaller 在仓库根目录随手生成的同名文件的。
!packaging/*.spec

# pip install -e . 的副产物
tu_shell_agent.egg-info/
*.egg-info/

# 开发过程记录（任务 brief、实现者报告、评审 diff、进度台账）：
# 它们是内部工作文件，不属于交付物。.superpowers/sdd/ 自己也有一个 `*` 规则，
# 这里再挡一层，避免将来 git add -A 把它们一起发出去。
.superpowers/
