# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 本机联调用的工具与隔离家目录（不入库）
tools/
.toolhome/

# 引擎默认输出目录（可用 --run-root/--templates-dir 改到别处）
.tu-runs/
.tu-templates/

# PyInstaller（Plan 2）
build/
dist/
*.spec
# 但 packaging/ 下的 spec 是交付物本身，必须入库：
# 上面那条 `*.spec` 原本是挡 pyinstaller 在仓库根目录随手生成的同名文件的。
!packaging/*.spec

# pip install -e . 的副产物
tu_shell_agent.egg-info/
*.egg-info/
